# Supabase (cliente y server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude (clasificación + resúmenes de incidencias)
ANTHROPIC_API_KEY=

# URL pública de la app (usada en links de emails y push)
NEXT_PUBLIC_APP_URL=https://app.residrix.com

# Resend (envío de emails transaccionales)
RESEND_API_KEY=
RESEND_FROM="Residrix <notifications@residrix.app>"

# Expo Push (opcional — solo si necesitas mayor cuota / verificación)
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_API_URL=

# Secreto compartido para los Database Webhooks de Supabase.
# Debe coincidir con app.settings.webhook_secret en el Postgres del proyecto Supabase.
SUPABASE_WEBHOOK_SECRET=

# Stripe billing — 3 tiers per-community
# Test mode: usa sk_test_... como secret key. Crea en el Dashboard un Product
# por tier con un Price recurrente per_unit, y copia los price_id (price_...).
#   - Base   : 12 €/comunidad/mes
#   - Pro    : 25 €/comunidad/mes
#   - Total  : 40 €/comunidad/mes
# El webhook secret lo da `stripe listen` (local) o el endpoint en el
# dashboard al apuntarlo a /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_BASE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TOTAL=
STRIPE_WEBHOOK_SECRET=
