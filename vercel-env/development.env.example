# Vercel Development environment
# Solo activo cuando alguien ejecuta `vercel dev` o similar.
# El `pnpm dev` local NO usa esto — usa apps/web/.env.local.
# Copia a development.env y rellena; después: pnpm vercel:env:sync development

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=

RESEND_API_KEY=
RESEND_FROM="Residrix <notifications@residrix.com>"

EXPO_ACCESS_TOKEN=

# Stripe TEST mode en development
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_BASE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TOTAL=
STRIPE_WEBHOOK_SECRET=

# AI provider selector: 'anthropic' | 'groq' (default: usa la primera key disponible)
AI_PROVIDER=
GROQ_API_KEY=

CRON_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
