# Vercel Preview environment
# Para deploys de branches != main. Normalmente apunta a una instancia
# de staging o usa los mismos test keys que Development.
# Copia a preview.env y rellena; después: pnpm vercel:env:sync preview

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=

RESEND_API_KEY=
RESEND_FROM="Residrix <notifications@residrix.com>"

EXPO_ACCESS_TOKEN=

# Stripe TEST mode en preview
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_BASE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TOTAL=
STRIPE_WEBHOOK_SECRET=
