# Vercel Production environment
# Valores reales (Stripe live, Supabase prod, etc.)
# Copia a production.env y rellena; después: pnpm vercel:env:sync production

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=

RESEND_API_KEY=
RESEND_FROM="Residrix <notifications@residrix.com>"

EXPO_ACCESS_TOKEN=

# Stripe LIVE mode en producción
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_BASE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TOTAL=
STRIPE_WEBHOOK_SECRET=

# AI provider selector: 'anthropic' | 'groq' (default: usa la primera key disponible)
AI_PROVIDER=
GROQ_API_KEY=

# Vercel Cron auth. Genera un random fuerte (openssl rand -hex 32) y úsalo
# como Bearer en pruebas manuales: curl -H "Authorization: Bearer $CRON_SECRET" ...
CRON_SECRET=

# Upstash Redis para rate limiting. Sin esto el rate limit queda OFF
# (no bloquea nada, solo loggea warning). Crear DB en https://upstash.com
# (free tier 500K cmds/mes) y copiar REST URL + TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry observability. Sin DSN el SDK queda en no-op. Crear proyecto
# Next.js en https://sentry.io (free tier 5k errors/mes). El AUTH_TOKEN
# solo es necesario en build para subir source maps; sin él el SDK
# funciona pero los stack traces salen minificados.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
