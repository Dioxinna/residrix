# Vercel Production environment
# Valores reales (Stripe live, Supabase prod, etc.)
# Copia a production.env y rellena; después: pnpm vercel:env:sync production

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=

RESEND_API_KEY=
RESEND_FROM="Residrix <notifications@residrix.com>"

EXPO_ACCESS_TOKEN=

# Stripe LIVE mode en producción
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_BASE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TOTAL=
STRIPE_WEBHOOK_SECRET=

# AI provider selector: 'anthropic' | 'groq' (default: usa la primera key disponible)
AI_PROVIDER=
GROQ_API_KEY=
